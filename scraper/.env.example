# Kopiér til ".env" og udfyld. ".env" er ignoreret af git.

# Din deployede worker, uden skråstreg til slut.
WORKER_URL="https://pokemon-scraper-bot.dit-subdomain.workers.dev"

# Skal matche INGEST_SECRET i worker'ens secrets.
INGEST_SECRET="samme_token_som_i_workeren"

# Minutter mellem hver runde. Der lægges op til et minuts slør oveni.
INTERVAL_MINUTES="10"

# Chrome-profilen. Den holder cookies mellem kørsler, så bot-beskyttelsen
# sjældnere skal udfordre os.
PROFILE_DIR="./.browser-profile"
